# ==========================================
# Stage 1: Build the SvelteKit app
# ==========================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install ALL dependencies (including dev tools like Vite/Tailwind)
COPY package*.json ./
RUN npm ci

# Copy the rest of the frontend source code
COPY . .

# Build the application (this creates the /build folder)
RUN npm run build

# Remove development dependencies so they don't bloat our final production image
RUN npm prune --production

# ==========================================
# Stage 2: Create the production image
# ==========================================
FROM node:20-alpine

WORKDIR /app

# Copy only the necessary files from the builder stage
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# The Node adapter defaults to port 3000
EXPOSE 3000

# Set environment to production
ENV NODE_ENV=production

# Start the Node server generated by SvelteKit
CMD ["node", "build"]